# Somado ao total mostrado na API e no painel; não é gravado no banco.
NUXT_SIGNATURE_COUNT_OFFSET=0
# Tempo para começar a assinar; sem toque, volta às boas-vindas.
NUXT_PUBLIC_SIGNATURE_IDLE_TIMEOUT_SECONDS=5
# Segundos com o dedo fora da tela que encerram a assinatura.
NUXT_PUBLIC_SIGNATURE_FINISH_PAUSE_SECONDS=2
# Limite oculto a partir do primeiro toque; a assinatura é salva ao atingi-lo.
NUXT_PUBLIC_SIGNATURE_MAX_SECONDS=30
